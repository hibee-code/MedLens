# =============================================================================
#  MedLens environment template
# =============================================================================
#  Documents every variable read by the application and by docker compose.
#  It holds NO real values and is safe to commit: never add any. Required
#  secrets show the placeholder CHANGE_ME, which the application rejects in
#  every environment; everything else is empty.
#
#  Local development   make dev-secrets
#                      Creates .env from this template (local endpoints,
#                      random secrets) or, if .env exists, adds new variables
#                      and fills missing or placeholder secrets while keeping
#                      your values. .env is gitignored.
#  Deployments         Provide the variables through your secret manager or
#                      orchestrator. Do not ship a .env file.
#
#  Naming      MEDLENS_<GROUP>__<FIELD> configures the application
#              (src/medlens/core/config.py). Other names are docker compose
#              only.
#  Empty       An empty value means "use the default" stated above it.
#  Formats     Booleans are true/false. Lists and maps are JSON.
#  Required.   The process refuses to start without it.
#  Secret.     Keep out of source control and logs. Secrets have no defaults.
#              Staging and production refuse well-known values, and refuse
#              secrets we choose ourselves (passwords, peppers) shorter than
#              32 characters.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Deployment environment: local, test, staging or production.
# Required.
MEDLENS_APP__ENVIRONMENT=
# Verbose DEBUG logging. Must be false in production.
# Default: false
MEDLENS_APP__DEBUG=
# Serve /docs, /redoc and /openapi.json. Unset: served everywhere except in
# production.
# Default: unset
MEDLENS_APP__DOCS_ENABLED=
# Browser origins allowed to call the API, as a JSON list. "*" is rejected in
# production.
# Default: []
MEDLENS_APP__CORS_ORIGINS=
# Largest request body accepted, in bytes. Enforced before any parsing.
# Default: 10485760
MEDLENS_APP__MAX_REQUEST_BODY_BYTES=
# Largest image upload, in bytes. Must be smaller than
# MEDLENS_APP__MAX_REQUEST_BODY_BYTES.
# Default: 8388608
MEDLENS_APP__MAX_UPLOAD_BYTES=
# Largest decoded image (width x height). Larger images are rejected as
# decompression bombs before they are decoded.
# Default: 50000000
MEDLENS_APP__MAX_IMAGE_PIXELS=
# Per-dependency timeout of GET /health/ready, in seconds.
# Default: 2.0
MEDLENS_APP__READINESS_TIMEOUT_SECONDS=

# -----------------------------------------------------------------------------
# Database (PostgreSQL, optionally through PgBouncer)
# -----------------------------------------------------------------------------
# Host of PostgreSQL or PgBouncer.
# Default: localhost
MEDLENS_DATABASE__HOST=
# Port of PostgreSQL or PgBouncer.
# Default: 5432
MEDLENS_DATABASE__PORT=
# Database name. docker compose also creates the database with it.
# Default: medlens
MEDLENS_DATABASE__NAME=
# Database user. docker compose also creates the role with it.
# Default: medlens
MEDLENS_DATABASE__USER=
# Database password (32+ characters in staging and production). docker compose
# also uses it for PostgreSQL and PgBouncer.
# Secret. Required.
MEDLENS_DATABASE__PASSWORD=CHANGE_ME
# Set to true when connecting through PgBouncer in transaction mode: disables
# server-side prepared statements.
# Default: false
MEDLENS_DATABASE__PGBOUNCER=
# Connections kept open per process.
# Default: 10
MEDLENS_DATABASE__POOL_SIZE=
# Extra connections allowed above the pool size under load.
# Default: 5
MEDLENS_DATABASE__MAX_OVERFLOW=
# Seconds to wait for a free pooled connection.
# Default: 10.0
MEDLENS_DATABASE__POOL_TIMEOUT_SECONDS=
# Seconds after which a pooled connection is replaced.
# Default: 1800
MEDLENS_DATABASE__POOL_RECYCLE_SECONDS=
# Seconds allowed to open a connection.
# Default: 5.0
MEDLENS_DATABASE__CONNECT_TIMEOUT_SECONDS=
# Client-side limit for a single statement, in seconds.
# Default: 30.0
MEDLENS_DATABASE__COMMAND_TIMEOUT_SECONDS=

# -----------------------------------------------------------------------------
# Redis (cache, rate limits, Celery broker and results)
# -----------------------------------------------------------------------------
# Redis host.
# Default: localhost
MEDLENS_REDIS__HOST=
# Redis port.
# Default: 6379
MEDLENS_REDIS__PORT=
# AUTH password (32+ characters in staging and production). Leave unset when
# Redis has no authentication.
# Secret. Default: unset
MEDLENS_REDIS__PASSWORD=
# Connect with TLS (rediss://).
# Default: false
MEDLENS_REDIS__TLS=
# Logical database for the cache. Cache, broker and result databases must differ.
# Default: 0
MEDLENS_REDIS__CACHE_DB=
# Logical database for the Celery broker. docker compose passes it to Flower.
# Default: 1
MEDLENS_REDIS__BROKER_DB=
# Logical database for Celery results.
# Default: 2
MEDLENS_REDIS__RESULT_DB=
# Seconds to wait for a reply.
# Default: 1.0
MEDLENS_REDIS__SOCKET_TIMEOUT_SECONDS=
# Seconds allowed to connect.
# Default: 0.5
MEDLENS_REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=
# Retries after a connection error or timeout (short jittered backoff). Callers
# fail open when Redis is down, so keep this small.
# Default: 1
MEDLENS_REDIS__RETRIES=
# Connection pool size per process.
# Default: 50
MEDLENS_REDIS__MAX_CONNECTIONS=

# -----------------------------------------------------------------------------
# Object storage (AWS S3, Cloudflare R2, MinIO)
# -----------------------------------------------------------------------------
# Endpoint of an S3-compatible service (MinIO, R2). Unset means AWS S3.
# Default: unset
MEDLENS_S3__ENDPOINT_URL=
# Region name.
# Default: us-east-1
MEDLENS_S3__REGION=
# Access key id. docker compose also uses it as the MinIO root user.
# Default: medlens-local
MEDLENS_S3__ACCESS_KEY_ID=
# Secret access key (32+ characters in staging and production). docker compose
# also uses it as the MinIO root password.
# Secret. Required.
MEDLENS_S3__SECRET_ACCESS_KEY=CHANGE_ME
# Bucket for pack images. docker compose creates it in MinIO.
# Default: medlens-local
MEDLENS_S3__BUCKET=
# URL style: path (MinIO), virtual or auto.
# Default: path
MEDLENS_S3__ADDRESSING_STYLE=
# Seconds allowed to connect.
# Default: 2.0
MEDLENS_S3__CONNECT_TIMEOUT_SECONDS=
# Seconds to wait for a response.
# Default: 10.0
MEDLENS_S3__READ_TIMEOUT_SECONDS=
# Attempts per request, including the first (1-10).
# Default: 3
MEDLENS_S3__MAX_ATTEMPTS=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Issuer (iss) of access tokens.
# Default: medlens
MEDLENS_AUTH__JWT_ISSUER=
# Audience (aud) of access tokens.
# Default: medlens-api
MEDLENS_AUTH__JWT_AUDIENCE=
# Access token lifetime in seconds (60-3600).
# Default: 900
MEDLENS_AUTH__ACCESS_TOKEN_TTL_SECONDS=
# Refresh token lifetime in days (1-90).
# Default: 30
MEDLENS_AUTH__REFRESH_TOKEN_TTL_DAYS=
# Ed25519 signing keys for access tokens, as a JSON map of key id to base64 of a
# 32-byte seed, e.g. {"2026-11":"<seed>"}. Generate a seed with
#   uv run python -m medlens.core.crypto
# Every key verifies; to rotate, add a key, point MEDLENS_AUTH__JWT_ACTIVE_KEY_ID
# at it, and remove the old one once its tokens have expired (15 minutes).
# Secret. Required.
MEDLENS_AUTH__JWT_KEYS='{"local-dev":"CHANGE_ME"}'
# Key id that signs new access tokens. Must be a key of MEDLENS_AUTH__JWT_KEYS.
# Default: local-dev
MEDLENS_AUTH__JWT_ACTIVE_KEY_ID=
# Lifetime of the token that carries a login to its MFA step, in seconds
# (60-900).
# Default: 300
MEDLENS_AUTH__MFA_TOKEN_TTL_SECONDS=
# Issuer name shown in authenticator apps.
# Default: MedLens
MEDLENS_AUTH__MFA_ISSUER=
# Lifetime of an SMS sign-in code, in seconds (60-900).
# Default: 300
MEDLENS_AUTH__OTP_TTL_SECONDS=
# Wrong attempts allowed per SMS code before it is invalidated (1-10).
# Default: 5
MEDLENS_AUTH__OTP_MAX_ATTEMPTS=
# Failed logins within the window that lock the account and the client IP.
# Default: 5
MEDLENS_AUTH__LOGIN_MAX_FAILURES=
# Window for counting failed logins, in seconds.
# Default: 900
MEDLENS_AUTH__LOGIN_FAILURE_WINDOW_SECONDS=
# First lockout, in seconds; each further lockout doubles it.
# Default: 60
MEDLENS_AUTH__LOGIN_LOCKOUT_BASE_SECONDS=
# Longest lockout, in seconds.
# Default: 3600
MEDLENS_AUTH__LOGIN_LOCKOUT_MAX_SECONDS=

# -----------------------------------------------------------------------------
# SMS (login codes only)
# -----------------------------------------------------------------------------
# console (logs messages; refused in production), termii or africastalking.
# Default: console
MEDLENS_SMS__PROVIDER=
# Sender id shown on the phone (must be registered with the provider).
# Default: MedLens
MEDLENS_SMS__SENDER_ID=
# Seconds allowed per request to the provider.
# Default: 10.0
MEDLENS_SMS__TIMEOUT_SECONDS=
# Termii API key. Required when the provider is termii.
# Secret. Default: unset
MEDLENS_SMS__TERMII_API_KEY=
# Termii API base URL.
# Default: https://api.ng.termii.com
MEDLENS_SMS__TERMII_BASE_URL=
# Africa's Talking username. Required when the provider is africastalking.
# Default: unset
MEDLENS_SMS__AFRICASTALKING_USERNAME=
# Africa's Talking API key. Required when the provider is africastalking.
# Secret. Default: unset
MEDLENS_SMS__AFRICASTALKING_API_KEY=
# Africa's Talking API base URL.
# Default: https://api.africastalking.com
MEDLENS_SMS__AFRICASTALKING_BASE_URL=

# -----------------------------------------------------------------------------
# Cryptography (PII field encryption and lookup hashes)
# -----------------------------------------------------------------------------
# Field-encryption keys (AES-256-GCM) as a JSON map of key id to base64 of 32
# random bytes, e.g. {"2026-11":"<key>"}. Generate a key with
#   uv run python -m medlens.core.crypto
# To rotate: add the new key, point MEDLENS_CRYPTO__ACTIVE_KEY_ID at it, and
# keep the old key until every row has been re-encrypted.
# Secret. Required.
MEDLENS_CRYPTO__FIELD_KEYS='{"local-dev":"CHANGE_ME"}'
# Key id used for new encryptions. Must be a key of MEDLENS_CRYPTO__FIELD_KEYS.
# Default: local-dev
MEDLENS_CRYPTO__ACTIVE_KEY_ID=
# Pepper for phone-lookup and IP hashes (16+ characters; 32+ in staging and
# production). Never change it once data exists: every stored hash would stop
# matching.
# Secret. Required.
MEDLENS_CRYPTO__HMAC_PEPPER=CHANGE_ME

# -----------------------------------------------------------------------------
# AI (all calls go through the LLM gateway)
# -----------------------------------------------------------------------------
# Global AI kill switch. false makes every AI feature use its non-AI fallback.
# Default: false
MEDLENS_LLM__ENABLED=
# Anthropic API key.
# Secret. Default: unset
MEDLENS_LLM__ANTHROPIC_API_KEY=
# Seconds allowed per model call.
# Default: 30.0
MEDLENS_LLM__REQUEST_TIMEOUT_SECONDS=
# Retries of a failed model call (0-5).
# Default: 2
MEDLENS_LLM__MAX_RETRIES=
# Model of the fast tier (pack-field extraction). Check docs.claude.com for
# current ids.
# Default: claude-haiku-5-5
MEDLENS_LLM__MODEL_FAST=
# Model of the balanced tier (assistant answers).
# Default: claude-sonnet-5-5
MEDLENS_LLM__MODEL_BALANCED=
# Daily spend limit in US dollars (UTC day). Model calls stop once the day's
# metered cost reaches it; 0 blocks every call.
# Default: 5.0
MEDLENS_LLM__DAILY_BUDGET_USD=
# Prices in US dollars per million tokens, as a JSON map of model id to
# input, output, cache_write and cache_read. Both tier models need an entry.
# Default: {"claude-haiku-5-5": {"input": 0.1, "output": 0.5, "cache_write": 0.125, "cache_read": 0.01}, "claude-sonnet-5-5": {"input": 2.0, "output": 10.0, "cache_write": 2.5, "cache_read": 0.2}}
MEDLENS_LLM__PRICES=
# Let the API rerun a refused balanced-tier request on a fallback model
# (server-side fallback, Claude API only).
# Default: true
MEDLENS_LLM__REFUSAL_FALLBACK=
# Seconds a validated assistant answer is reused for an identical request (same
# model, prompt version, documents and question); 0: off.
# Default: 3600
MEDLENS_LLM__ANSWER_CACHE_SECONDS=
# Load the models in workers (`ml` group). false, or a missing model, makes
# visual matching, semantic search and reranking unavailable.
# Default: true
MEDLENS_EMBEDDINGS__ENABLED=
# onnx (the exports in ONNX_DIR, baked into the worker image) or torch
# (sentence-transformers). onnx falls back to torch when the exports are missing.
# Default: onnx
MEDLENS_EMBEDDINGS__BACKEND=
# Folder of the ONNX exports (scripts/export_onnx.py).
# Default: /opt/models/onnx
MEDLENS_EMBEDDINGS__ONNX_DIR=
# ONNX Runtime threads per model and worker process.
# Default: 2
MEDLENS_EMBEDDINGS__ONNX_THREADS=
# ONNX Runtime's memory arena: true is faster, false keeps about 1 GB less per worker process
# after large batches.
# Default: true
MEDLENS_EMBEDDINGS__ONNX_MEMORY_ARENA=
# Image embedding model for visual matching.
# Default: clip-ViT-B-32
MEDLENS_EMBEDDINGS__IMAGE_MODEL=
# Dimension of image embeddings (clip-ViT-B-32: 512, at most 2000). Read by the
# migrations that create the vector column: changing it needs a new migration.
# Default: 512
MEDLENS_EMBEDDINGS__IMAGE_DIMENSION=
# Text embedding model for document search.
# Default: intfloat/multilingual-e5-small
MEDLENS_EMBEDDINGS__TEXT_MODEL=
# Dimension of text embeddings (multilingual-e5-small: 384). Read by the
# migration that creates the chunks table.
# Default: 384
MEDLENS_EMBEDDINGS__TEXT_DIMENSION=
# Cross-encoder that reranks search results (torch backend; the onnx backend uses
# the exported one).
# Default: cross-encoder/ms-marco-MiniLM-L-6-v2
MEDLENS_EMBEDDINGS__RERANKER_MODEL=

# -----------------------------------------------------------------------------
# Verification pipeline and risk scoring (docs/scoring.md)
# -----------------------------------------------------------------------------
# Risk score at or above which a pack is SUSPICIOUS (0-1, below the high-priority
# threshold).
# Default: 0.3
MEDLENS_VERIFICATION__SUSPICIOUS_THRESHOLD=
# Risk score at or above which a SUSPICIOUS pack is high priority and opens a
# review case.
# Default: 0.6
MEDLENS_VERIFICATION__HIGH_PRIORITY_THRESHOLD=
# Fields read with less confidence (0-1) are read again by the next stage
# (OCR, then the vision LLM when AI is on).
# Default: 0.6
MEDLENS_VERIFICATION__MIN_FIELD_CONFIDENCE=
# Quality gate: photos whose shorter side has fewer pixels are TOO_SMALL.
# Default: 480
MEDLENS_VERIFICATION__MIN_SIDE_PIXELS=
# Quality gate: variance of the Laplacian below which a photo is BLURRY.
# Default: 60.0
MEDLENS_VERIFICATION__BLUR_THRESHOLD=
# Quality gate: mean grey level (0-255) below which a photo is TOO_DARK.
# Default: 40.0
MEDLENS_VERIFICATION__DARK_THRESHOLD=
# Quality gate: mean grey level (0-255) above which a photo is TOO_BRIGHT.
# Default: 235.0
MEDLENS_VERIFICATION__BRIGHT_THRESHOLD=
# Window, in days, for counting the states where a batch was scanned.
# Default: 30
MEDLENS_VERIFICATION__SPREAD_WINDOW_DAYS=
# A batch scanned in more states than this within the window is suspicious.
# Default: 3
MEDLENS_VERIFICATION__SPREAD_STATE_LIMIT=
# The same photo from the same person or device within this many hours returns
# the earlier result (0 disables).
# Default: 24
MEDLENS_VERIFICATION__DUPLICATE_WINDOW_HOURS=
# Seconds after which pipeline stages still pending are skipped (lowering
# confidence) so every scan finishes.
# Default: 20.0
MEDLENS_VERIFICATION__PIPELINE_TIMEOUT_SECONDS=
# Seconds registered products are cached in Redis for scan lookups. Product facts
# change only through the Greenbook import, which takes this long to show. 0: off.
# Default: 60
MEDLENS_VERIFICATION__PRODUCT_CACHE_SECONDS=
# real (OpenCV quality gate, zxing barcodes, Tesseract OCR when installed;
# needs the `vision` group) or fake (no readers; tests).
# Default: real
MEDLENS_VERIFICATION__READERS=

# -----------------------------------------------------------------------------
# Background jobs (Celery, outbox relay, backpressure, retention)
# -----------------------------------------------------------------------------
# Seconds between outbox relay runs (Beat). Sets the shortest delay before a
# scan starts processing.
# Default: 1.0
MEDLENS_QUEUE__RELAY_INTERVAL_SECONDS=
# Outbox events moved per relay run.
# Default: 100
MEDLENS_QUEUE__RELAY_BATCH_SIZE=
# Failed relay attempts after which an outbox event is dead-lettered.
# Default: 10
MEDLENS_QUEUE__RELAY_MAX_ATTEMPTS=
# Pool processes per worker container. Each loads the embedding models (about
# 1 GB of memory), so scale by adding containers.
# Default: 2
MEDLENS_QUEUE__WORKER_CONCURRENCY=
# Seconds before a task is asked to stop (SoftTimeLimitExceeded).
# Default: 120
MEDLENS_QUEUE__TASK_SOFT_TIME_LIMIT_SECONDS=
# Seconds before a task is killed. Must exceed the soft limit.
# Default: 180
MEDLENS_QUEUE__TASK_TIME_LIMIT_SECONDS=
# Seconds before the broker re-delivers an unacknowledged task. Must exceed the
# task time limit.
# Default: 3600
MEDLENS_QUEUE__VISIBILITY_TIMEOUT_SECONDS=
# Queued scans above which POST /scans reports a growing wait.
# Default: 200
MEDLENS_QUEUE__SCANS_SOFT_LIMIT=
# Queued scans above which POST /scans answers 503 with Retry-After.
# Default: 2000
MEDLENS_QUEUE__SCANS_HARD_LIMIT=
# Extra estimated wait per queued scan above the soft limit, in seconds.
# Default: 0.5
MEDLENS_QUEUE__SECONDS_PER_QUEUED_SCAN=
# Sync fast path: seconds POST /scans may wait for the verdict when the queue is
# short (0-20). 0 turns it off.
# Default: 8.0
MEDLENS_QUEUE__SYNC_WAIT_SECONDS=
# Days a scan photo is kept. Match the bucket lifecycle rule on scans/.
# Default: 180
MEDLENS_QUEUE__SCAN_IMAGE_RETENTION_DAYS=

# -----------------------------------------------------------------------------
# Knowledge base and assistant (document ingestion and retrieval)
# -----------------------------------------------------------------------------
# Largest document upload, in bytes. Keep it below
# MEDLENS_APP__MAX_REQUEST_BODY_BYTES, which applies first.
# Default: 8388608
MEDLENS_KNOWLEDGE__MAX_DOCUMENT_BYTES=
# The assistant's own kill switch: when false, questions get search results only
# (MEDLENS_LLM__ENABLED=false switches off every AI feature).
# Default: true
MEDLENS_KNOWLEDGE__ASSISTANT_ENABLED=
# Target chunk size, in tokens (estimated).
# Default: 400
MEDLENS_KNOWLEDGE__CHUNK_TOKENS=
# Tokens repeated between consecutive chunks. Must be below the chunk size.
# Default: 60
MEDLENS_KNOWLEDGE__CHUNK_OVERLAP_TOKENS=
# Candidates taken from each retriever (vector, full text) before fusion.
# Default: 20
MEDLENS_KNOWLEDGE__CANDIDATES=
# Results kept after fusion.
# Default: 6
MEDLENS_KNOWLEDGE__TOP_K=
# Cosine similarity a vector-only hit needs to count as evidence (0-1).
# Default: 0.8
MEDLENS_KNOWLEDGE__MIN_SIMILARITY=
# Reciprocal Rank Fusion constant.
# Default: 60
MEDLENS_KNOWLEDGE__RRF_K=
# Seconds the API waits for a worker to embed a question; slower, search runs
# on keywords and NAFDAC numbers only.
# Default: 5.0
MEDLENS_KNOWLEDGE__QUERY_EMBEDDING_TIMEOUT_SECONDS=
# Re-order the best search candidates with the cross-encoder (in a worker).
# Default: true
MEDLENS_KNOWLEDGE__RERANK=
# Fused candidates passed to the reranker.
# Default: 20
MEDLENS_KNOWLEDGE__RERANK_CANDIDATES=
# Seconds the API waits for the reranker; slower, the fused order stands.
# Default: 5.0
MEDLENS_KNOWLEDGE__RERANK_TIMEOUT_SECONDS=
# The assistant's evidence bar on reranked passages (0-1): weaker passages are not given to the
# model; with none left, the answer is "not enough evidence" without a model call.
# Default: 0.1
MEDLENS_KNOWLEDGE__MIN_RERANK_SCORE=
# Seconds question embeddings are cached in Redis (per model); 0: off.
# Default: 86400
MEDLENS_KNOWLEDGE__QUERY_CACHE_SECONDS=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Service name on logs, traces and metrics.
# Default: medlens
MEDLENS_OBSERVABILITY__SERVICE_NAME=
# DEBUG, INFO, WARNING or ERROR. MEDLENS_APP__DEBUG=true forces DEBUG.
# Default: INFO
MEDLENS_OBSERVABILITY__LOG_LEVEL=
# auto (JSON in staging and production, console elsewhere), json or console.
# Default: auto
MEDLENS_OBSERVABILITY__LOG_FORMAT=
# OTLP/HTTP collector endpoint (traces are sent to <endpoint>/v1/traces), e.g.
# http://otel-collector:4318 with the observability compose profile. Unset: no
# tracing.
# Default: unset
MEDLENS_OBSERVABILITY__OTLP_ENDPOINT=
# Share of traces sampled (0-1).
# Default: 0.1
MEDLENS_OBSERVABILITY__TRACES_SAMPLE_RATE=
# Sentry DSN for error reporting.
# Secret. Default: unset
MEDLENS_OBSERVABILITY__SENTRY_DSN=
# Seconds between the API's own dependency probes, which keep the
# medlens_dependency_up metric (and the Redis-down alert) current. 0 disables.
# Default: 15.0
MEDLENS_OBSERVABILITY__DEPENDENCY_PROBE_INTERVAL_SECONDS=
# Port on which each Celery worker container serves its Prometheus metrics
# (0: off). Internal only, like the API's /metrics.
# Default: 9100
MEDLENS_OBSERVABILITY__WORKER_METRICS_PORT=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Enforce rate limits (sliding windows in Redis; checks are skipped while Redis
# is down). Client IPs come from Uvicorn, which trusts X-Forwarded-For only from
# FORWARDED_ALLOW_IPS.
# Default: true
MEDLENS_RATELIMIT__ENABLED=
# Scans per minute from one client IP without signing in.
# Default: 10
MEDLENS_RATELIMIT__GUEST_SCANS_PER_MINUTE=
# Scans per minute per signed-in user or API key.
# Default: 30
MEDLENS_RATELIMIT__USER_SCANS_PER_MINUTE=
# Login and sign-in-code attempts per minute from one client IP.
# Default: 5
MEDLENS_RATELIMIT__LOGINS_PER_MINUTE=
# Assistant questions per minute per user.
# Default: 10
MEDLENS_RATELIMIT__ASSISTANT_PER_MINUTE=

# -----------------------------------------------------------------------------
# docker compose only (host ports bind to 127.0.0.1)
# -----------------------------------------------------------------------------
# Host port of the API.
# Default: 8000
API_HOST_PORT=
# Host port of PostgreSQL, for direct access such as migrations.
# Default: 5433
POSTGRES_HOST_PORT=
# Host port of PgBouncer.
# Default: 6432
PGBOUNCER_HOST_PORT=
# Host port of Redis.
# Default: 6380
REDIS_HOST_PORT=
# Host port of the MinIO S3 API.
# Default: 9000
MINIO_HOST_PORT=
# Host port of the MinIO console.
# Default: 9001
MINIO_CONSOLE_HOST_PORT=
# Host port of Flower (Celery dashboard). Never expose it publicly.
# Default: 5555
FLOWER_HOST_PORT=
# Flower login as user:password.
# Secret. Required.
FLOWER_BASIC_AUTH=medlens:CHANGE_ME
# Host port of the OpenTelemetry collector's gRPC receiver (observability
# profile).
# Default: 4317
OTLP_GRPC_HOST_PORT=
# Host port of the OpenTelemetry collector's HTTP receiver (observability
# profile).
# Default: 4318
OTLP_HTTP_HOST_PORT=
# Host port of the Jaeger UI (observability profile).
# Default: 16686
JAEGER_UI_HOST_PORT=
# Host port of Prometheus (observability profile).
# Default: 9090
PROMETHEUS_HOST_PORT=
# Host port of Grafana (observability profile).
# Default: 3000
GRAFANA_HOST_PORT=
# Grafana administrator user.
# Default: admin
GRAFANA_ADMIN_USER=
# Grafana administrator password.
# Secret. Required.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
